# 必填：Discord Developer Portal 內的 Bot Token
DISCORD_BOT_TOKEN=

# 必填：先使用 OpenRouter；openrouter/free 會依附圖自動挑選視覺模型
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
# 附圖時使用的模型。維持 openrouter/free 即自動路由；也可改成 OpenRouter 上的 Gemini 模型名稱。
LLM_VISION_MODEL=openrouter/free

# OpenRouter 回傳 402／429 或免費額度用盡時，自動切換至 Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# 雲端的 /play 與 /spotify 也控制同一個官方 Spotify Premium 帳號
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# 必填：雲端版只允許這個 Discord 使用者，避免其他人消耗 AI 額度
DISCORD_ALLOWED_USER_IDS=798893182883463179
# 伺服器與頻道可留空；使用者白名單仍會強制套用
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_REQUIRE_MENTION=true

# 雲端服務設定
DATA_DIR=/data
PORT=3000
HISTORY_MESSAGES=8
MAX_OUTPUT_TOKENS=500
BOT_ACTIVITY=在雲端守望永晝花庭
CLOUD_MUSIC_MONTHLY_MINUTES=300

# 雲端音樂只接受直接網址或已收藏歌曲；搜尋、推薦、分析不會呼叫 AI。
# 每月最多播放 300 分鐘，達到限制後自動停止，預留免費層流量空間。
# AI 語音、Spotify/Bilibili 搜尋與其他媒體處理只留在桌面版；圖片可由 OpenRouter 視覺模型直接辨識。

# 必填：Discord Developer Portal 內的 Bot Token
DISCORD_BOT_TOKEN=

# 必填：OpenAI 相容的聊天 API
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# 建議填寫，逗號分隔；空白表示不限制
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_REQUIRE_MENTION=true

# 雲端服務設定
DATA_DIR=/data
PORT=3000
HISTORY_MESSAGES=20
BOT_ACTIVITY=在雲端守望永晝花庭

{
  "name": "live2d-cyrene",
  "version": "1.0.0",
  "description": "Live2D desktop pet — Cyrene",
  "main": "dist/main/main/index.js",
  "bin": {
    "cyrene": "./dist/cli/index.js"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').cpSync('src/main/orchestrator/code/cline-esm-bridge.mjs','dist/main/main/orchestrator/code/cline-esm-bridge.mjs')\"",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build:skills": "tsc -p tsconfig.skills.json",
    "build:cli": "node scripts/build-cli.mjs",
    "build:screenshot-helper": "node scripts/build-screenshot-helper.mjs",
    "verify:screenshot-helper": "node scripts/verify-screenshot-helper.mjs resources/bin/cyrene-screenshot.exe",
    "build": "npm run build:skills && npm run build:main && npm run build:preload && npm run build:cli && npm run build:renderer",
    "package:win:dir": "npm run build && npm run build:screenshot-helper && electron-builder --win --dir",
    "dev": "npm run build:skills && npm run build:main && npm run build:preload && npm run build:cli && concurrently \"vite\" \"cross-env VITE_DEV=1 electron .\"",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:music": "npm run build:main && node scripts/run-music-smoke.mjs",
    "build:sim": "tsc -p tsconfig.sim.json",
    "sim": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js",
    "sim:coffee": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=coffee",
    "sim:mix": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix",
    "sim:rescue": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=rescue",
    "sim:sweep": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix --rewardGain=3,5,7,10"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qr-image": "^3.2.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vite": "7.3.6",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "@cline/sdk": "0.0.66",
    "@lancedb/lancedb": "^0.30.0",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/deepseek": "^1.1.5",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/jieba": "^2.0.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@playwright/mcp": "^0.0.79",
    "@types/ws": "^8.18.1",
    "@xenova/transformers": "^2.17.2",
    "antd": "^6.5.2",
    "chart.js": "^4.5.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.0.0",
    "langchain": "^1.5.4",
    "llamaindex": "^0.12.1",
    "marked": "^16.4.2",
    "mdast-util-to-string": "^4.0.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.49.0",
    "pdfkit": "^0.19.1",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.3.0",
    "playwright": "^1.60.0",
    "qr-image": "^3.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-parse": "^11.0.0",
    "rxjs": "^7.8.1",
    "shiki": "^4.3.1",
    "silk-wasm": "^3.7.1",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "wink-bm25-text-search": "^3.1.2",
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "protobufjs@7.6.4": true,
    "protobufjs@6.11.6": true,
    "electron@43.1.0": true,
    "esbuild@0.21.5": true,
    "sharp@0.32.6": true,
    "tree-sitter@0.22.4": true
  }
}
